{
  "schema_version": "tmcra.public-release-manifest.1",
  "distribution": "owner-local-source",
  "allowed_top_level_directories": [
    ".agents",
    ".github",
    "assets",
    "benchmarks",
    "code",
    "docs",
    "integrations",
    "models",
    "results",
    "runtime",
    "scripts"
  ],
  "allowed_root_files": [
    ".gitattributes",
    ".gitignore",
    "AUTHORS.md",
    "CHANGELOG.md",
    "CITATION.cff",
    "LICENSE",
    "NOTICE",
    "PUBLIC_RELEASE_MANIFEST.json",
    "README.md",
    "README.zh-CN.md",
    "SECURITY.md"
  ],
