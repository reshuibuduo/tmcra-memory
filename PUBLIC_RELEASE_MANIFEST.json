    "docs/WORKFLOW_COMMANDS.zh-CN.md",
    "docs/WORKFLOW_MCP_API.zh-CN.md"
  ],
  "excluded_capabilities": [
    "hosted-account-control-plane",
    "hosted-billing-and-subscriptions",
    "staff-and-tenant-administration",
    "production-deployment-secrets",
    "production-observability-and-operations",
    "private-training-corpora-and-run-state",
    "desktop-installer-binaries"
  ],
  "network_contract": {
    "local_api_bind": "127.0.0.1",
    "silent_cloud_fallback": false,
    "external_generation": "explicit-user-BYOK-only"
  }
}
