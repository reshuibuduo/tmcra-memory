    "runtime/src/tmcra_local/api.py",
    "runtime/src/tmcra_local/engine.py",
    "scripts/install-local.ps1",
    "scripts/install-local.sh",
    "scripts/start-local.ps1",
    "scripts/start-local.sh",
    "scripts/uninstall-local.ps1",
    "scripts/uninstall-local.sh",
    "scripts/audit_public_release.py",
    "scripts/smoke_local_api.py",
    "scripts/install-codex-local.ps1",
    "scripts/install-codex-local.sh",
    "scripts/install-deepseek-harness-local.ps1",
    "scripts/install-deepseek-harness-local.sh",
    "integrations/local-agent-hooks/hooks/hooks.json",
    "integrations/local-agent-hooks/lib/local_memory.mjs",
    "integrations/deepseek-harness-local/src/index.ts",
    "docs/LOCAL_DEPLOYMENT.md",
    "docs/LOCAL_DEPLOYMENT.zh-CN.md",
    "docs/LOCAL_API.md",
    "docs/LOCAL_API.zh-CN.md",
    "docs/LOCAL_INTEGRATIONS.md",
    "docs/LOCAL_INTEGRATIONS.zh-CN.md",
    "docs/PUBLIC_RELEASE_BOUNDARY.md",
    "docs/PUBLIC_RELEASE_BOUNDARY.zh-CN.md",
    "models/tmcra_v4_longmemeval_s500_20260715/TMCRA_MODEL_MANIFEST.json",
    "integrations/local-agent-hooks/.mcp.json",
    "integrations/local-agent-hooks/scripts/workflow_mcp.mjs",
    "integrations/local-agent-hooks/skills/tmcra-workflows/SKILL.md",
